{
  "name": "knas-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "sync:news": "node scripts/sync-knas-news.mjs",
    "sync:calendar": "node scripts/sync-nahouw-calendar.mjs",
    "sync:international": "node scripts/sync-international-entries.mjs",
    "prebuild": "npm run sync:news && npm run sync:calendar && npm run sync:international",
    "build": "vite build",
    "package:share": "powershell -NoProfile -Command \"if (Test-Path 'dist-share-package.zip') { Remove-Item 'dist-share-package.zip' -Force }; Compress-Archive -Path 'dist\\*' -DestinationPath 'dist-share-package.zip' -Force\"",
    "build:share": "npm run build && npm run package:share",
    "prebuild:single": "npm run sync:news && npm run sync:calendar && npm run sync:international",
    "build:single": "vite build --config vite.singlefile.config.ts",
    "build:single:offline": "npm run build:single && node scripts/embed-offline-singlefile.mjs",
    "preview:single": "vite preview --config vite.singlefile.config.ts --host 0.0.0.0 --port 4174",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^5.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
